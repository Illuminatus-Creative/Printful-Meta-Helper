{
    "name": "illuminatus-creative/printful-meta-helper",
    "description": "Internal WooCommerce blank/size-chart plugin.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "test": "phpunit",
        "lint": "for f in $(find . -name '*.php' -not -path './vendor/*'); do php -l $f || exit 1; done"
    }
}
